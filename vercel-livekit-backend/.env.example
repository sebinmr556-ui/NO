# NOICE LIVE — Vercel LiveKit Backend Environment Variables
# Deploy URL: https://noice-live26.vercel.app

# Required LiveKit Cloud / Server credentials (already set to true on noice-live26.vercel.app)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Firebase Project ID (defaults automatically to project-7eddf9da-6480-4ac9-a2d if omitted)
FIREBASE_PROJECT_ID=project-7eddf9da-6480-4ac9-a2d

# Optional Firebase Admin Service Account (if omitted, backend verifies Firebase ID tokens via Google public x509 certs)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
