                         (request.auth.uid != existing().userId &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'commentsCount', 'viewsCount', 'sharesCount', 'savesCount', 'likedByUids', 'viewedByUids', 'savedByUids', 'trendingScore', 'updatedAt']))
                       );

      allow delete: if isSignedIn() && isValidId(postId) && (request.auth.uid == existing().userId || isSuperOwner());

      match /comments/{commentId} {
        allow get: if isSignedIn() && isValidId(postId) && isValidId(commentId);
        allow list: if isSignedIn() && existing().appScope == 'noise_live_public';

        allow create: if isSignedIn() &&
                         isValidId(postId) &&
                         isValidId(commentId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().postId == postId &&
                         incoming().keys().hasAll(['postId', 'userId', 'appScope', 'username', 'text', 'createdAt']) &&
                         incoming().keys().hasOnly(['postId', 'userId', 'appScope', 'username', 'text', 'createdAt']) &&
                         isValidComment(incoming()) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time;

        allow delete: if isSignedIn() && isValidId(postId) && isValidId(commentId) && (request.auth.uid == existing().userId || isSuperOwner());
      }
