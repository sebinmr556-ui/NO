      allow create, update, delete: if isSuperOwner() && isValidId(backupId);
    }

    match /central_ai_command_logs/{logId} {
      allow get, list: if isSuperOwner();
      allow create, update, delete: if isSuperOwner() && isValidId(logId);
    }

    match /developer_studio_files/{fileId} {
      allow get, list: if isSuperOwner();
      allow create, update, delete: if isSuperOwner() && isValidId(fileId);
    }

    match /developer_studio_branches/{branchId} {
      allow get, list: if isSuperOwner();
      allow create, update, delete: if isSuperOwner() && isValidId(branchId);
    }

    match /developer_studio_commits/{commitId} {
      allow get, list: if isSuperOwner();
      allow create, update, delete: if isSuperOwner() && isValidId(commitId);
    }

    match /developer_studio_deployments/{deployId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSuperOwner() && isValidId(deployId);
    }

    match /developer_studio_bug_reports/{bugId} {
      allow get, list: if isSuperOwner();
      allow create, update, delete: if isSuperOwner() && isValidId(bugId);
    }

    match /developer_studio_chat/{msgId} {
      allow get, list: if isSuperOwner();
      allow create, update, delete: if isSuperOwner() && isValidId(msgId);
    }

    match /developer_studio_config/{docId} {
      allow get, list: if isSuperOwner();
      allow create, update, delete: if isSuperOwner() && isValidId(docId);
    }

    match /user_moderation/{userId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSuperOwner() && isValidId(userId);
    }

    match /reports/{reportId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() &&
                    isValidId(reportId) &&
                    incoming().reporterUid == request.auth.uid &&
                    incoming().status == 'open';
      allow update, delete: if isSuperOwner() && isValidId(reportId);
    }
  }
}

